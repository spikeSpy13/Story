{
  "name": "story-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "content": "python3 scripts/build_content.py",
    "dev": "vite --host 0.0.0.0",
    "build": "npm run content && vite build",
